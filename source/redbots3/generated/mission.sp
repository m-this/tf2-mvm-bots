/* Generated by internal/spbody from the Go it is named after. Do not edit. */

stock bool IsTFBotPlayer(int client)
{
	return IsFakeClient(client);
}

stock bool IsFinalWave()
{
	int rsrc = FindEntityByClassname(MaxClients + 1, "tf_objective_resource");
	if (rsrc != -1)
	{
		if (TF2_GetMannVsMachineWaveCount(rsrc) == TF2_GetMannVsMachineMaxWaveCount(rsrc))
		{
			return true;
		}
	}
	else
	{
		LogError("IsFinalWave: Could find entity tf_objective_resource!");
	}
	return false;
}

stock bool IsSentryBusterRobot(int client)
{
	if (IsTFBotPlayer(client))
	{
		return GetTFBotMission(client) == CTFBot_MISSION_DESTROY_SENTRIES;
	}
	char model[512];
	GetClientModel(client, model, 512);
	return StrEqual(model, "models/bots/demo/bot_sentry_buster.mdl");
}

stock int SelectRandomReachableEnemy(int actor)
{
	TFTeam opposingTeam = GetPlayerEnemyTeam(actor);
	int playerarray[65];
	int playercount = 0;
	for (int i = 1; i <= MaxClients; i++)
	{
		if (i == actor)
		{
			continue;
		}
		if (!IsClientInGame(i))
		{
			continue;
		}
		if (!IsPlayerAlive(i))
		{
			continue;
		}
		if (TF2_GetClientTeam(i) != opposingTeam)
		{
			continue;
		}
		if (TF2Util_IsPointInRespawnRoom(WorldSpaceCenter(i)))
		{
			continue;
		}
		if (IsSentryBusterRobot(i))
		{
			continue;
		}
		playerarray[playercount] = i;
		playercount++;
	}
	if (playercount > 0)
	{
		return playerarray[GetRandomInt(0, playercount - 1)];
	}
	return -1;
}

